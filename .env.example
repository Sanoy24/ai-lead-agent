# Copy this file to .env and adjust it. Every setting has a working default for the local demo.

# --- Business -------------------------------------------------------------
BUSINESS_NAME="Brightline Solar & Roofing"
# The wording next to the form's consent checkbox. Stored with every lead.
# CONSENT_TEXT="By submitting this form you agree that we may contact you ..."
# TOML file with the business description, questions and scoring rules.
# Defaults to the bundled demo business (src/lead_agent/demo/business.toml).
# BUSINESS_PROFILE=./business.toml

# --- Dashboard ------------------------------------------------------------
# Set a password to turn on the dashboard and its admin API.
# ADMIN_PASSWORD=
# Keeps people signed in across restarts. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# SESSION_SECRET=

# --- Language model -------------------------------------------------------
# Any OpenAI-compatible API. The default is a local Ollama server (free).
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=granite4.2:8b
LLM_REASONING_EFFORT=none
# Free hosted option: OpenRouter's free models (rate limited).
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_API_KEY=sk-or-...
# LLM_MODEL=nvidia/nemotron-3.5-lightning:free
# LLM_FALLBACK_MODELS=google/gemma-4-26b-a4b-it:free,inclusionai/ling-3.2-flash:free
# LLM_REASONING_EFFORT=

# --- Intake ---------------------------------------------------------------
# Enables POST /api/webhooks/leads. Senders sign the raw request body with
# HMAC-SHA256 and send it as: X-Signature-256: sha256=<hex>
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# WEBHOOK_SECRET=
# A repeat submission from the same email or phone within this many hours is
# added to the existing lead instead of creating a new one.
DUPLICATE_WINDOW_HOURS=24
FORM_RATE_LIMIT_PER_MINUTE=5

# --- App ------------------------------------------------------------------
DATABASE_URL=sqlite:///data/local/leads.db
# Websites allowed to embed the lead form, as a JSON list.
# ALLOWED_ORIGINS=["https://your-site.com"]

# --- Telegram (optional) --------------------------------------------------
# Anyone who messages your bot becomes a lead and gets a reply from the agent.
# Create a bot with @BotFather and paste its token here. /stop opts out.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_RATE_LIMIT_PER_MINUTE=20

# --- Email (optional) -----------------------------------------------------
# Without these, replies to email leads are only written to the log.
# A free Gmail account works: turn on 2-step verification, create an app
# password, and use it below. Use a mailbox dedicated to leads if you can:
# unread mail that isn't from a lead is left unread for a person.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURITY=starttls
# SMTP_USERNAME=you@gmail.com
# SMTP_PASSWORD=
# EMAIL_FROM=you@gmail.com
# Read replies (uses the SMTP username and password unless set):
# IMAP_HOST=imap.gmail.com
# IMAP_PORT=993
# IMAP_POLL_SECONDS=60

# --- Booking (optional) ---------------------------------------------------
# In Cal.com: Settings > Developer > Webhooks > New, URL
# https://<your-server>/api/webhooks/calcom, events Booking Created,
# Rescheduled and Cancelled, and the same secret as below.
# CALCOM_WEBHOOK_SECRET=

# --- HubSpot (optional) ---------------------------------------------------
# Free HubSpot CRM: Settings > Integrations > Private apps > Create, with the
# crm.objects.contacts.read and crm.objects.contacts.write scopes.
# HUBSPOT_ACCESS_TOKEN=
# Your HubSpot account id, so the dashboard can link to each contact:
# HUBSPOT_PORTAL_ID=
# Where this app is reachable, for links back from HubSpot notes:
# PUBLIC_URL=https://leads.example.com
